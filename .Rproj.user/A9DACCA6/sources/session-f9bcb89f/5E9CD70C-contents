#A3

#' A3SS: one shared splice donor + two alternative acceptor sites.
#' Shared sits at the low end on + strand, high end on - strand
#' (same convention as AL). "near"/"far" = distance from the shared site.
get_a3_layout <- function(c1, c2, c3, strand) {
  if (strand == "-") {
    list(shared = c3, alt_near = c2, alt_far = c1)
  } else {
    list(shared = c1, alt_near = c2, alt_far = c3)
  }
}

build_a3_arcs_for_condition <- function(ev, psi_col, cond_label) {
  strand <- unique(ev$strand)
  layout <- get_a3_layout(ev$c1, ev$c2, ev$c3, strand)
  
  bind_rows(
    ev %>% transmute(event_id, gene_id,
                     junc_start = layout$shared, junc_end = layout$alt_near,
                     weight = .data[[psi_col]], arc_type = "proximal_acceptor",
                     condition = cond_label),
    ev %>% transmute(event_id, gene_id,
                     junc_start = layout$shared, junc_end = layout$alt_far,
                     weight = 1 - .data[[psi_col]], arc_type = "distal_acceptor",
                     condition = cond_label)
  )
}


