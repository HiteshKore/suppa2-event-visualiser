get_event_type <- function(event_id) {
  sub(":.*", "", sub(".*;", "", event_id))
}

splicing_type=get_event_type(target_event)

print(splicing_type)

dir.create(outdir, showWarnings = FALSE, recursive = TRUE)

# --- load SUPPA2 outputs ---
ioe <- fread(ioe_file)

print(target_event)

ioe_sub <- if (!is.na(target_event)) {
  ioe[ioe[["event_id"]] %in% target_event, ]
} else {
  ioe
}

stopifnot(nrow(ioe_sub) > 0)
#print("------")
#print(ioe_sub)

junctions <- build_raw_junction_table_from_ioe(ioe_sub)



psi1 <- fread(psi_cond1); setnames(psi1, 1, "event_id")
psi2 <- fread(psi_cond2); setnames(psi2, 1, "event_id")
psi1_mean <- psi1[, .(event_id, psi_cond1 = rowMeans(.SD, na.rm = TRUE)), .SDcols = setdiff(names(psi1), "event_id")]
psi2_mean <- psi2[, .(event_id, psi_cond2 = rowMeans(.SD, na.rm = TRUE)), .SDcols = setdiff(names(psi2), "event_id")]

junctions <- junctions %>%
  left_join(psi1_mean, by = "event_id") %>%
  left_join(psi2_mean, by = "event_id") %>%
  filter(!is.na(psi_cond1) | !is.na(psi_cond2))

if (file.exists(dpsi_file)) {
  dpsi <- fread(dpsi_file); setnames(dpsi, 1, "event_id")
  dpsi_col  <- grep("dPSI", names(dpsi), value = TRUE)[1]
  pval_col  <- grep("p-val", names(dpsi), value = TRUE, ignore.case = TRUE)[1]
  junctions <- junctions %>%
    left_join(dpsi %>% dplyr::select(event_id, dPSI = all_of(dpsi_col), pvalue = all_of(pval_col)), by = "event_id") 
}

# --- collapse to one row per event (c1:c4), works for SE and RI alike ---
events <- collapse_to_event_coordinates(junctions)
ioe_sub_transcripts<-ioe_sub%>%dplyr::select(event_id,total_transcripts)

events<-left_join(events,ioe_sub_transcripts,by="event_id")


# --- load GTF once, reuse for every event ---
gtf <- import(reference_gtf)

unique_genes <- data.frame(gene_id = unique(events$gene_id)) %>%
  mutate(gene_name = sapply(gene_id, function(g) get_gene_name(gtf, get_primary_gene_id(g))))

events <- events %>% left_join(unique_genes, by = "gene_id")%>%filter(event_type==splicing_type)

print(events)

# --- one figure per event, saved to disk ---
for (eid in unique(events$event_id)) {
  #print(eid)
  p <- plot_event(eid, events, gtf, cond1_name, cond2_name)
  p
  safe_name <- str_replace_all(eid, "[:;]", "_")
  #print(safe_name)
  ggsave(file.path(outdir, paste0(safe_name, ".png")), p, width = 7, height = 5, dpi = 300)
}
message("Wrote ", length(unique(events$event_id)), " event plot(s) to '", outdir, "/'")