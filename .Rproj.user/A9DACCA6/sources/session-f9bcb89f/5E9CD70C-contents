#' A5SS: two alternative 5' donor sites splice into one SHARED
#' downstream acceptor exon. Mirror of A3 -- shared sits at the
#' HIGH end on + strand (opposite of A3, where shared sits low).
get_a5_layout <- function(c1, c2, c3, strand) {
  if (strand == "-") {
    list(shared = c1, alt_near = c2, alt_far = c3)
  } else {
    list(shared = c3, alt_near = c2, alt_far = c1)
  }
}

