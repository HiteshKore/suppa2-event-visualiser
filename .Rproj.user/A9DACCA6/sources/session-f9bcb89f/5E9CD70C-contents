#AF event
#' Returns the genomic (start,end) pair for exon A, exon B, and the
#' single shared-junction coordinate, correctly oriented for strand.
get_af_layout <- function(c1, c2, c3, c4, c5, strand) {
  if (strand == "-") {
    list(exonA = c(c4, c5), exonB = c(c2, c3), shared = c1)
  } else {
    list(exonA = c(c1, c2), exonB = c(c3, c4), shared = c5)
  }
}
