#' Tag which exon (in the transcript track) corresponds to which AF
#' so it can be highlighted in a different color.
mark_affected_exons_af <- function(tx_exons, c1, c2, c3, c4, c5, strand) {
  layout <- get_af_layout(c1, c2, c3, c4, c5, strand)
  tx_exons %>%
    mutate(affected = case_when(
      start == layout$exonA[1] & end == layout$exonA[2] ~ "first_exon_A",
      start == layout$exonB[1] & end == layout$exonB[2] ~ "first_exon_B",
      start == layout$shared | end == layout$shared      ~ "shared_downstream",
      TRUE                                                ~ "other"
    ))
}


#AL event
#' AL is AF mirrored: a SHARED exon splices into two alternative LAST
#' exons, instead of two alternative first exons sharing one downstream
#' exon. Shared sits at the low end on + strand, high end on - strand.
get_al_layout <- function(c1, c2, c3, c4, c5, strand) {
  if (strand == "-") {
    list(exonA = c(c1, c2), exonB = c(c3, c4), shared = c5)
  } else {
    list(exonA = c(c2, c3), exonB = c(c4, c5), shared = c1)
  }
}

get_al_junction_pairs <- function(c1, c2, c3, c4, c5, strand) {
  if (strand == "-") {
    list(exonA_junc = c(c5, c2), exonB_junc = c(c5, c4))
  } else {
    list(exonA_junc = c(c1, c2), exonB_junc = c(c1, c4))
  }
}

#arc builder

build_al_arcs_for_condition <- function(ev, psi_col, cond_label) {
  strand <- unique(ev$strand)
  jp <- get_al_junction_pairs(ev$c1, ev$c2, ev$c3, ev$c4, ev$c5, strand)
  
  bind_rows(
    ev %>% transmute(event_id, gene_id,
                     junc_start = jp$exonA_junc[1], junc_end = jp$exonA_junc[2],
                     weight = .data[[psi_col]], arc_type = "last_exon_A", condition = cond_label),
    ev %>% transmute(event_id, gene_id,
                     junc_start = jp$exonB_junc[1], junc_end = jp$exonB_junc[2],
                     weight = 1 - .data[[psi_col]], arc_type = "last_exon_B", condition = cond_label)
  )
}

#Transcript fetch + exon tagging: AL
get_transcripts_for_al_event <- function(gtf, gene_id_val, c1, c2, c3, c4, c5, strand,total_transcripts) {
  layout <- get_al_layout(c1, c2, c3, c4, c5, strand)
