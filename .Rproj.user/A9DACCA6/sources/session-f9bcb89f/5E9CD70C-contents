  bind_rows(
    ev %>% transmute(event_id, gene_id,
                     junc_start = layout$alt_near, junc_end = layout$shared,
                     weight = .data[[psi_col]], arc_type = "proximal_donor",
                     condition = cond_label),
    ev %>% transmute(event_id, gene_id,
                     junc_start = layout$alt_far, junc_end = layout$shared,
                     weight = 1 - .data[[psi_col]], arc_type = "distal_donor",
                     condition = cond_label)
  )
}

