#' Draw one condition's arc panel. `blocks` is optional (NULL for
#' SE, a retention-level table for RI) -- when present it's drawn
#' as a shaded rect on the gene line under the arcs.
plot_condition_panel <- function(cond_label, arcs, exons, blocks, xlim, c1, c4, pad) {
  arc_c     <- arcs %>% dplyr::filter(condition == cond_label)
  
  label_pts <- arc_c %>%
    dplyr::mutate(is_downward = arc_type %in% c("distal_acceptor","distal_donor")) %>%
    dplyr::group_by(junc_id, arc_type) %>%
    dplyr::group_modify(~ {
      if (unique(.x$is_downward)) {
        dplyr::slice_min(.x, y, n = 1, with_ties = FALSE)
      } else {
        dplyr::slice_max(.x, y, n = 1, with_ties = FALSE)
      }
    }) %>%
    dplyr::ungroup() %>%
    dplyr::mutate(label_y = ifelse(is_downward, y - 0.25, y + 0.25))
   # dplyr::mutate(label_y = y + sign(y) * 0.15)
  
  #print(arc_c %>% dplyr::filter(condition == "gfp") %>% dplyr::group_by(arc_type) %>%
          #dplyr::summarise(min_x = min(x), max_x = max(x), min_y = min(y), max_y = max(y)))
  
  
  p <- ggplot() +
    geom_segment(aes(x = c1 - pad, xend = c4 + pad, y = 0, yend = 0),
                 color = "black", linewidth = 0.4) +
    geom_rect(data = exons, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
              fill = "black")
  
  if (!is.null(blocks)) {
    block_c <- blocks %>% dplyr::filter(condition == cond_label)
    p <- p + geom_rect(data = block_c,
                       aes(xmin = xstart, xmax = xend, ymin = -0.06, ymax = 0.06,
                           alpha = retention_level),
                       fill = "steelblue")+
      geom_label(data = block_c,                                    # NEW
                aes(x = (xstart + xend) / 2, y = -0.15,             # sits just below the block
                    label = sprintf("%.2f", retention_level)),
                size = 3.2, color = "blue",                                    # CHANGED: was steelblue4
                fill = "white",
                label.size = 0,
                label.padding = unit(0.12, "lines"))
  }

  
  p +
    geom_path(data = arc_c,
              aes(x = x, y = y, group = junc_id, linewidth = weight, alpha = weight),
              color = "firebrick") +
    geom_label(data = label_pts,
               aes(x = x, y = label_y, label = sprintf("%.2f", weight)),
               size = 3.2,
               color = "blue",             # NEW: label text color, contrasts with the red arc
               fill = "white",              # NEW: opaque background so the arc never shows through
               label.size = 0,              # removes the label's border outline
               label.padding = unit(0.12, "lines"))+   # keeps the background pill small/tight
    #geom_text(data = label_pts,
    #          aes(x = x, y = y + 0.1, label = sprintf("%.2f", weight)),
    #          size = 3.2, color = "firebrick") +
    scale_linewidth(range = c(0.4, 4), limits = c(0, 1), guide = "none") +
    scale_alpha(range = c(0.45, 1), limits = c(0, 1), guide = "none") +
    coord_cartesian(xlim = xlim, ylim = c(-1.6,1.6)) +
    labs(y = cond_label) +
    theme_void() +
    theme(axis.title.y = element_text(angle = 90, size = 11, face = "bold"),
          plot.margin = margin(8, 12, 8, 12))
}

#' Transcript track: one row per transcript, exons as boxes
#' (affected ones highlighted), genomic coordinate ticks along
#' the x-axis, all in the same display-space x as the arc panels.
plot_transcript_track <- function(tx_exons, xlim) {
  tx_ids <- sort(unique(tx_exons$transcript_id))
  y_map  <- setNames(seq_along(tx_ids), tx_ids)
  tx_exons <- tx_exons %>% mutate(y = y_map[transcript_id])

  
  introns <- tx_exons %>%
    group_by(transcript_id, y) %>%
    summarise(xstart = min(xmin), xend = max(xmax), .groups = "drop")
  #print(introns)
  # genomic <-> display coordinate ticks, taken straight from each
  # exon boundary already mapped through g2d()
   tick_df <- bind_rows(
     tx_exons %>% dplyr::select(genomic = start, display = xmin),
     tx_exons %>% dplyr::select(genomic = end,   display = xmax)
   ) %>%
     dplyr::distinct() %>%
     dplyr::arrange(display)
   
   ggplot() +
     geom_segment(data = introns, aes(x = xstart, xend = xend, y = y, yend = y),
                  color = "black", linewidth = 0.3) +
     geom_rect(data = tx_exons,
               aes(xmin = xmin, xmax = xmax, ymin = y - 0.32, ymax = y + 0.32,
                   fill = affected != "other"),
               color = NA) +
     scale_fill_manual(values = c(`TRUE` = "firebrick", `FALSE` = "grey35"), guide = "none") +
     scale_y_continuous(breaks = y_map, labels = names(y_map)) +
     scale_x_continuous(breaks = tick_df$display,
                        labels = format(tick_df$genomic, big.mark = ",", scientific = FALSE)) +
     coord_cartesian(xlim = xlim) +
     theme_classic(base_size = 8) +
     theme(axis.title = element_blank(), panel.grid = element_blank(),
           axis.text.x = element_text(angle = 45, hjust = 1, size = 6),
           axis.ticks.x = element_line())
}

#' Full per-event figure: two condition arc panels + one transcript
#' track, all sharing the same GTF-derived display-space x-axis.
#' Dispatches SE vs RI internally via build_event_arcs_and_blocks().
plot_event <- function(event_id_val, events, gtf, cond1_name, cond2_name) {
  ev_row <- events %>% dplyr::filter(event_id == event_id_val)
  event_type <- ev_row$event_type
  #print(ev_row$gene_id)
  gene_id_for_gtf <- get_primary_gene_id(ev_row$gene_id)
  # NEW: significance stars from the single event-level p-value
  sig_stars <- dplyr::case_when(
    ev_row$pvalue < 0.001 ~ "***",
    ev_row$pvalue < 0.01  ~ "**",
    ev_row$pvalue < 0.05  ~ "*",
    TRUE                  ~ ""
  )
  
  # --- STEP 1: fetch event-flanking transcripts + tag affected exons
  #     (SE vs RI specific fetch/tag logic, same for both from here on) ---
  if (event_type == "SE") {
    tx_exons_raw <- get_transcripts_for_se_event(gtf, ev_row$gene_id, ev_row$c1, ev_row$c4,ev_row$total_transcripts)
    tx_exons     <- mark_affected_exons_se(tx_exons_raw, ev_row$c1, ev_row$c2, ev_row$c3, ev_row$c4)
  } else if (event_type == "RI") {
    tx_exons_raw <- get_transcripts_for_ri_event(gtf, ev_row$gene_id, ev_row$c2, ev_row$c3,ev_row$total_transcripts)
    tx_exons     <- mark_affected_exons_ri(tx_exons_raw, ev_row$c2, ev_row$c3)
  }else if (event_type == "MX") {   
    tx_exons_raw <- get_transcripts_for_mx_event(gtf, ev_row$gene_id,ev_row$c1, ev_row$c2, ev_row$c3,ev_row$c4, ev_row$c5, ev_row$c6,ev_row$total_transcripts)
    tx_exons     <- mark_affected_exons_mx(tx_exons_raw, ev_row$c2, ev_row$c3, ev_row$c4, ev_row$c5)
  } else if (event_type == "AF") {
    
    tx_exons_raw <- get_transcripts_for_af_event(gtf, ev_row$gene_id,ev_row$c1, ev_row$c2, ev_row$c3,ev_row$c4, ev_row$c5, ev_row$strand,ev_row$total_transcripts)
    tx_exons <- mark_affected_exons_af(tx_exons_raw,ev_row$c1, ev_row$c2, ev_row$c3,ev_row$c4, ev_row$c5, ev_row$strand)
    #print(tx_exons)
    
  }else if (event_type == "AL") {
    tx_exons_raw <- get_transcripts_for_al_event(gtf, ev_row$gene_id,ev_row$c1, ev_row$c2, ev_row$c3,ev_row$c4, ev_row$c5, ev_row$strand,ev_row$total_transcripts)
    tx_exons <- mark_affected_exons_al(tx_exons_raw,ev_row$c1, ev_row$c2, ev_row$c3,ev_row$c4, ev_row$c5, ev_row$strand)
  }else if (event_type == "A3") {
    gene_id_for_gtf <- get_primary_gene_id(ev_row$gene_id)
    #print("-----")
    tx_exons_raw <- get_transcripts_for_a3_event(gtf, gene_id_for_gtf, ev_row$c1, ev_row$c2, ev_row$c3, ev_row$strand,ev_row$total_transcripts)
    
    tx_exons     <- mark_affected_exons_a3(tx_exons_raw, ev_row$c1, ev_row$c2, ev_row$c3, ev_row$strand)
    #print(tx_exons)
    
    
  }else if (event_type == "A5") {
    gene_id_for_gtf <- get_primary_gene_id(ev_row$gene_id)
    tx_exons_raw <- get_transcripts_for_a5_event(gtf, gene_id_for_gtf, ev_row$c1, ev_row$c2, ev_row$c3,
                                                 ev_row$strand, ev_row$total_transcripts)
    tx_exons     <- mark_affected_exons_a5(tx_exons_raw, ev_row$c1, ev_row$c2, ev_row$c3, ev_row$strand)
  }else {
    stop("Invalid Event")
  }
  
  # prevents unrelated exons elsewhere in the matched transcripts (e.g.
  # further downstream/upstream of an AF/AL event) from sneaking into
  # the visible window and rendering as an unexpected extra exon box.
  event_coords <- c(ev_row$c1, ev_row$c2, ev_row$c3, ev_row$c4, ev_row$c5, ev_row$c6)
  event_bounds <- range(event_coords, na.rm = TRUE)
  tx_exons_raw <- tx_exons_raw %>%dplyr::filter(end >= event_bounds[1], start <= event_bounds[2])
  #print(tx_exons_raw)
  
  
  # --- STEP 2: collapse to a clean, non-overlapping exon union and
  #     build the ONE genomic->display axis -- SAME reduce() logic
  #     regardless of event type ---
   tx_union_exons <- tx_exons_raw %>%
     dplyr::select(start, end) %>%
     dplyr::distinct() %>%
     dplyr::arrange(start)
   
   ir <- IRanges::reduce(IRanges::IRanges(tx_union_exons$start, tx_union_exons$end))
   tx_union_exons <- data.frame(start = BiocGenerics::start(ir), end = BiocGenerics::end(ir))
   #print(tx_union_exons)
   
   g2d <- build_gene_axis(tx_union_exons)   # built exactly once, works for either event type
   
  # --- STEP 3: NOW g2d exists, so map event coordinates ---
   c1 <- g2d(ev_row$c1); c2 <- g2d(ev_row$c2)
   c3 <- g2d(ev_row$c3); c4 <- g2d(ev_row$c4)
   
   c_right <- if (event_type == "MX") {
     g2d(ev_row$c6)
   } else if (event_type %in% c("AF", "AL")) {
     g2d(ev_row$c5)
   } else if (event_type %in% c("A3", "A5")) {
     c3
   } else {
     c4
   }
   
   # --- STEP 4: arcs / blocks, via the SE/RI dispatcher, mapped through g2d ---
   r1 <- build_event_arcs_and_blocks(ev_row, "psi_cond1", cond1_name)
   r2 <- build_event_arcs_and_blocks(ev_row, "psi_cond2", cond2_name)
   #print(r1)
   jt <- bind_rows(r1$arcs, r2$arcs) %>%
    mutate(junc_start = g2d(junc_start), junc_end = g2d(junc_end))
   #print(jt)
   arcs <- build_arc_df(jt)
   
   blocks <- NULL
   if (!is.null(r1$blocks)) {
     blocks <- bind_rows(r1$blocks, r2$blocks) %>%
       mutate(xstart = g2d(xstart), xend = g2d(xend))
   }
   
  # --- STEP 5: gene exon boxes (from the union track) and per-transcript
  #      exon boxes (un-collapsed), both mapped through the SAME g2d ---
  exons <- tx_union_exons %>%
     rowwise() %>%
     mutate(xmin = g2d(start), xmax = g2d(end)) %>%
     ungroup() %>%
     transmute(xmin, xmax, ymin = -0.06, ymax = 0.06)
  #print(exons)
   tx_exons <- tx_exons %>%dplyr::filter(end >= event_bounds[1], start <= event_bounds[2]) %>%
     rowwise() %>%
     mutate(xmin = g2d(start), xmax = g2d(end)) %>%
     ungroup()
   
   #print(tx_exons$transcript_id%>%unique())
   
   #
  # # --- STEP 6: assemble the figure ---
   pad <- (c_right - c1) * 0.08
   xlim_shared <- c(c1 - pad, c_right + pad)
   
   p1 <- plot_condition_panel(cond1_name, arcs, exons, blocks, xlim_shared, c1, c_right, pad)
   p2 <- plot_condition_panel(cond2_name, arcs, exons, blocks, xlim_shared, c1, c_right, pad)
   tx_panel <- plot_transcript_track(tx_exons, xlim_shared)
   
   subtitle_text <- sprintf("%s\ndPSI = %.2f, p = %.3g%s",ev_row$event_id, ev_row$dPSI, ev_row$pvalue, sig_stars)
   
   title_text <- if (!is.na(ev_row$gene_name)) { 
     sprintf("%s (%s)", ev_row$gene_name, ev_row$gene_id)
   } else {
     ev_row$gene_id
   }
   
   n_tx <- length(unique(tx_exons$transcript_id))
   (p1 / p2 / tx_panel) +
     plot_layout(heights = c(1, 1, max(0.6, n_tx * 0.35))) +
     plot_annotation(title = title_text, subtitle = subtitle_text,
                     theme = theme(plot.title = element_text(hjust = 0.5, face = "bold"),
                                   plot.subtitle = element_text(hjust = 0.5, size = 10),
                                   plot.margin = margin(5, 5, 15, 5)))
}

