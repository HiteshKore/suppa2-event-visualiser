#!/usr/bin/env Rscript
# ============================================================
# suppa2_arc_plot_refactored.R
#
# LeafCutter-style arc plots from SUPPA2 output, for BOTH
# skipped-exon (SE) and retained-intron (RI) events, with a
# GTF-aligned genomic axis and a transcript track underneath.
#
# STRUCTURE OF THIS FILE
#   1. Libraries
#   2. Generic SUPPA2 event-ID parsing (works for any 4-coordinate
#      event: SE, RI, A5, A3 -- all share this coordinate shape)
#   3. Event-type-specific arc/block builders
#        - SE: two inclusion arcs (shared PSI) + one reconstructed
#              exclusion arc (1 - PSI)
#        - RI: one spliced-junction arc (1 - PSI) + one retention
#              block drawn on the gene line (PSI)
#   4. Arc geometry (shared by both event types)
#   5. GTF helpers: gene exon structure, genomic->display axis,
#      transcript fetching, affected-exon tagging
#   6. Plotting: one condition panel, one transcript track,
#      one full per-event figure (dispatches SE vs RI internally)
#   7. Main script: load SUPPA2 files, build events, build GTF
#      axis, loop over events and save one figure per event
#
# KEY IDEA: for a 4-coordinate SUPPA2 event, c1 < c2 < c3 < c4.
#   SE -> c1,c2 = upstream junction ; c2,c3 = the skipped exon
#         (NOT a junction)         ; c3,c4 = downstream junction
#   RI -> c1,c2 = upstream exon (not drawn as a junction)
#         c2,c3 = the retained INTRON (the one real junction/
#         retention span)          ; c3,c4 = downstream exon
# Both event types reuse the SAME generic coordinate collapse in
# section 2/7 -- only the arc/block builders in section 3 differ.
# ============================================================

# ------------------------------------------------------------
# 1. LIBRARIES
#    dplyr is loaded LAST so its verbs (select/filter/slice) win
#    over same-named functions from Bioconductor GTF packages.
# ------------------------------------------------------------
suppressPackageStartupMessages({
  library(data.table)
  library(optparse)
  library(rtracklayer)
  library(stringr)
  library(ggplot2)
  library(patchwork)
  library(tidyr)
  library(dplyr)
})

# ============================================================
# 2. GENERIC SUPPA2 EVENT-ID PARSING
#    Format: <gene_id>;<event_type>:<chr>:<c1>-<c2>:<c3>-<c4>:<strand>
#    This works identically for SE and RI event IDs -- both have
#    exactly two "start-end" coordinate blocks. What differs is
#    only how those 4 coordinates get INTERPRETED later.
# ============================================================

get_gene_name <- function(gtf, gene_id_val) {
  hit <- gtf[gtf$gene_id == gene_id_val]   # drop the type == "gene" filter
  if (length(hit) == 0 || is.null(hit$gene_name)) return(NA_character_)
  unique(hit$gene_name)[1]
}

#' Parse the gene id, event type, chromosome, strand and raw
#' coordinate blocks out of one or more SUPPA2 event_id strings.
parse_suppa2_event_id <- function(event_id) {

  parts  <- str_split(event_id, ";", simplify = TRUE)
  gene   <- parts[, 1]
  fields <- str_split(parts[, 2], ":", simplify = TRUE)
  
  event_type   <- fields[, 1]
  chrom        <- fields[, 2]
  strand       <- fields[, ncol(fields)]
  coord_blocks <- fields[, 3:(ncol(fields) - 1), drop = FALSE]
  
  list(gene = gene, event_type = event_type, chr = chrom,
       strand = strand, coord_blocks = coord_blocks)
}

#' Explode every event_id in an .ioe table into individual
#' "junction" rows -- one row per pair of consecutive genomic
#' coordinates. For a 4-coordinate event this yields 3 rows:
#' (c1-c2), (c2-c3), (c3-c4). NOTE: not all 3 rows are real
#' splice junctions -- see event-type-specific builders below,
#' which reinterpret these coordinate pairs correctly per type.
build_raw_junction_table_from_ioe <- function(ioe_dt) {
  parsed <- parse_suppa2_event_id(ioe_dt$event_id)
  #ENSG00000112062.12;MX:chr6:36076608-36095987:36096066-36102571:36076608-36100188:36100267-36102571:+
  junc_list <- list()
  for (i in seq_len(nrow(ioe_dt))) {
    blocks <- parsed$coord_blocks[i, ]
    blocks <- blocks[blocks != ""]
    coords <- sort(unique(as.numeric(unlist(str_split(blocks, "-")))))
    if (length(coords) < 2) next
    
    for (j in seq_len(length(coords) - 1)) {
      junc_list[[length(junc_list) + 1]] <- data.table(
        event_id   = ioe_dt$event_id[i],
        gene_id    = parsed$gene[i],
        event_type = parsed$event_type[i],
        chr        = parsed$chr[i],
        strand     = parsed$strand[i],
        junc_start = coords[j],
        junc_end   = coords[j + 1]
      )
    }
  }
  rbindlist(junc_list)
}

#' Collapse the exploded per-junction rows back down to one row
#' per event, keeping only clean 4-coordinate events (SE/RI/A5/A3)
#' and splitting the 4 coordinates out into c1 < c2 < c3 < c4.
collapse_to_event_coordinates <- function(junctions_with_psi) {
  collapsed <- junctions_with_psi %>%
    group_by(event_id, gene_id, event_type, chr, strand) %>%
    summarise(
      coords    = list(sort(unique(c(junc_start, junc_end)))),
      psi_cond1 = dplyr::first(psi_cond1),
      psi_cond2 = dplyr::first(psi_cond2),
      dPSI      = dplyr::first(dPSI),
      pvalue    = dplyr::first(pvalue),
      .groups = "drop"
    )%>%
     filter(lengths(coords) >= 3)          # CHANGED: was == 4, now accepts 4 or more
   
  # # how many coordinate columns we need overall, based on the longest event
   max_coords <- max(lengths(collapsed$coords))
  # dynamically build c1..cN, NA-padding events with fewer coordinates than max_coords
   coord_matrix <- t(sapply(collapsed$coords, function(x) {
     length(x) <- max_coords    # pads with NA if shorter than max_coords
     x
   }))
   
   
   colnames(coord_matrix) <- paste0("c", seq_len(max_coords))
   #print(coord_matrix)
   collapsed %>%
     select(-coords) %>%
     bind_cols(as.data.frame(coord_matrix))
}


# ============================================================
# 3. EVENT-TYPE-SPECIFIC ARC / BLOCK BUILDERS
#    Each takes one row of the "events" table (already collapsed
#    to c1:c4) plus which PSI column/condition to use, and returns
#    the junction(s) that should be drawn as arcs for that event.
# ============================================================

#' SE (skipped exon): two inclusion junctions sharing the same
#' PSI/thickness, plus a reconstructed exclusion junction (c1->c4)
#' weighted 1 - PSI. No retention block for SE.
build_se_arcs_for_condition <- function(ev, psi_col, cond_label) {
  bind_rows(
    ev %>% transmute(event_id, gene_id, c1, c2, c3, c4,
                     junc_start = c1, junc_end = c2,
                     weight = .data[[psi_col]], arc_type = "inclusion",
                     condition = cond_label),
    ev %>% transmute(event_id, gene_id, c1, c2, c3, c4,
                     junc_start = c3, junc_end = c4,
                     weight = .data[[psi_col]], arc_type = "inclusion",
                     condition = cond_label),
    ev %>% transmute(event_id, gene_id, c1, c2, c3, c4,
                     junc_start = c1, junc_end = c4,
                     weight = 1 - .data[[psi_col]], arc_type = "exclusion",
                     condition = cond_label)
  )
}

#' RI (retained intron): the intron itself is c2->c3 (upstream exon
#' ends at c2, downstream exon starts at c3). There is exactly ONE
#' real junction -- splicing the intron out -- weighted by the
#' spliced fraction (1 - PSI, since SUPPA2's RI PSI = retention
#' level). The retained fraction (PSI) is returned separately as a
#' "block" to be shaded directly on the gene line, not drawn as an arc.
build_ri_arcs_and_blocks_for_condition <- function(ev, psi_col, cond_label) {
  arcs <- ev %>% transmute(event_id, gene_id, c1, c2, c3, c4,
                           junc_start = c2, junc_end = c3,
                           weight = 1 - .data[[psi_col]],
                           arc_type = "spliced_junction",
                           condition = cond_label)
  blocks <- ev %>% transmute(event_id, gene_id,
                             xstart = c2, xend = c3,
                             retention_level = .data[[psi_col]],
                             condition = cond_label)
  list(arcs = arcs, blocks = blocks)
}


#' MX (mutually exclusive exons): exon A's two junctions share PSI,
#' exon B's two junctions share (1 - PSI). No exclusion arc -- there's
#' always exactly one exon included, just which one varies.
build_mx_arcs_for_condition <- function(ev, psi_col, cond_label) {
  bind_rows(
    ev %>% transmute(event_id, gene_id, junc_start = c1, junc_end = c2,
                     weight = .data[[psi_col]], arc_type = "exonA", condition = cond_label),
    ev %>% transmute(event_id, gene_id, junc_start = c3, junc_end = c6,
                     weight = .data[[psi_col]], arc_type = "exonA", condition = cond_label),
    ev %>% transmute(event_id, gene_id, junc_start = c1, junc_end = c4,
                     weight = 1 - .data[[psi_col]], arc_type = "exonB", condition = cond_label),
    ev %>% transmute(event_id, gene_id, junc_start = c5, junc_end = c6,
                     weight = 1 - .data[[psi_col]], arc_type = "exonB", condition = cond_label)
  )
}
#' Dispatcher: given one event's row and event_type, route to the
#' correct builder above. Returns a list(arcs = ..., blocks = ...)
#' for every event type -- blocks is NULL for event types that
#' don't use one (e.g. SE).
build_event_arcs_and_blocks <- function(ev, psi_col, cond_label) {
  event_type <- unique(ev$event_type)
  if (event_type == "SE") {
    list(arcs = build_se_arcs_for_condition(ev, psi_col, cond_label),
         blocks = NULL)
  } else if (event_type == "RI") {
    build_ri_arcs_and_blocks_for_condition(ev, psi_col, cond_label)
  }else if (event_type == "MX") {                                    # NEW
    list(arcs = build_mx_arcs_for_condition(ev, psi_col, cond_label),
         blocks = NULL)
  } else if (event_type == "AF") {
    
    list( arcs = build_af_arcs_for_condition(ev, psi_col,cond_label),blocks = NULL)
    
  } else if (event_type == "AL") {
    list(arcs = build_al_arcs_for_condition(ev, psi_col, cond_label), blocks = NULL)
  }else if (event_type == "A3") {
    list(arcs = build_a3_arcs_for_condition(ev, psi_col, cond_label), blocks = NULL)
  }else if (event_type == "A5") {
    list(arcs = build_a5_arcs_for_condition(ev, psi_col, cond_label), blocks = NULL)
  }else {
    stop("Invalid Event")
  }
}

#build af arcs for conditions
#' Returns the genomic (start,end) pair for exon A, exon B, and the
#' single shared-junction coordinate, correctly oriented for strand.


build_af_arcs_for_condition <- function(ev, psi_col, cond_label) {
  strand <- unique(ev$strand)
  layout <- get_af_layout(ev$c1, ev$c2, ev$c3, ev$c4, ev$c5, strand)
  
  # On + strand the exon's splice-donor end is its genomic END (index 2).
  # On - strand transcription runs the other way, so the splice-donor
  # end is the exon's genomic START (index 1).
  donor_idx <- if (strand == "-") 1 else 2
  
  bind_rows(
    ev %>% transmute(
      event_id, gene_id,
      junc_start = layout$exonA[donor_idx], junc_end = layout$shared,
      weight     = .data[[psi_col]],
      arc_type   = "first_exon_A",
      condition  = cond_label
    ),
    ev %>% transmute(
      event_id, gene_id,
      junc_start = layout$exonB[donor_idx], junc_end = layout$shared,
      weight     = 1 - .data[[psi_col]],
      arc_type   = "first_exon_B",
      condition  = cond_label
    )
  )
}
# ============================================================
# 4. ARC GEOMETRY (shared by SE and RI)
# ============================================================

#' Quadratic-bezier arc between two x positions, peaking at `height`.
make_arc <- function(x_start, x_end, height, n = 60) {
  t     <- seq(0, 1, length.out = n)
  x_mid <- (x_start + x_end) / 2
  x <- (1 - t)^2 * x_start + 2 * (1 - t) * t * x_mid + t^2 * x_end
  y <- 2 * (1 - t) * t * height
  data.frame(x = x, y = y)
}

#' Turn a long-format junction table (junc_start, junc_end, weight,
#' arc_type, condition) into per-point arc coordinates for geom_path.
#' Exclusion (SE) / spliced (RI) junctions are drawn taller so they
#' visually sit above the inclusion arcs beneath them.

build_arc_df <- function(junc_dt) {
  arcs <- vector("list", nrow(junc_dt))
  for (i in seq_len(nrow(junc_dt))) {
    row <- junc_dt[i, ]
    height <- dplyr::case_when(
      row$arc_type %in% c("exclusion", "spliced_junction") ~ 1.4,
      row$arc_type %in% c("exonB", "first_exon_B", "last_exon_B") ~ 1.0,
      row$arc_type == "proximal_acceptor" ~ 1.0,     # A3: arcs UP
      row$arc_type == "distal_acceptor"   ~ -1.0,    # A3: arcs DOWN
      row$arc_type == "distal_acceptor" ~ 1.0,     # A5: arcs UP
      row$arc_type == "distal_donor"   ~ -1.0,    # A5: arcs DOWN
      #row$arc_type %in% c("distal_acceptor", "distal_donor")     ~ -0.8,
      TRUE ~ 0.6
    )
    arc <- make_arc(row$junc_start, row$junc_end, height)
    arc$junc_id   <- paste0(row$junc_start, "-", row$junc_end)
    arc$weight    <- row$weight
    arc$arc_type  <- row$arc_type
    arc$condition <- row$condition
    arcs[[i]] <- arc
  }
  bind_rows(arcs)
}

# ============================================================
# 5. GTF HELPERS
# ============================================================
#' SUPPA2 concatenates multiple overlapping gene IDs with "_and_" when
#' an event's coordinates fall within more than one annotated gene.
#' For GTF lookups, just use the first listed gene.
get_primary_gene_id <- function(gene_id_val) {
  str_split(gene_id_val, "_and_")[[1]][1]
}
#' All unique (union) exon boundaries across every transcript of a
#' gene -- used only to build the genomic->display axis, not for
#' the transcript track itself (see get_transcripts_flanking_event).
get_gene_exons <- function(gtf, gene_id_val) {
  ex <- gtf[gtf$type == "exon" & gtf$gene_id == gene_id_val]
  
  ex_df <- as.data.frame(ex) %>%
    dplyr::select(seqnames, start, end, strand) %>%
    dplyr::distinct() %>%
    dplyr::arrange(start)
  ir <- IRanges::reduce(IRanges::IRanges(ex_df$start, ex_df$end))
  data.frame(start = BiocGenerics::start(ir), end = BiocGenerics::end(ir))
}

#' Build a genomic-position -> compressed-display-position lookup
#' function. Exons get a small fixed display width (exon_scale),
#' introns get a larger fixed display width (intron_display_width)
#' regardless of true length -- this is what keeps a 150 bp exon
#' visible next to a 13,000 bp intron.
build_gene_axis <- function(exon_df, intron_display_width = 4, exon_scale = 0.02,exon_display_max = 6) {
  exon_df <- exon_df %>% dplyr::arrange(start)
  segments <- list()
  cursor <- 0
  for (i in seq_len(nrow(exon_df))) {
    ex_len <- exon_df$end[i] - exon_df$start[i]
    ex_disp_len <- min(max(ex_len * exon_scale, 0.5), exon_display_max) 
    segments[[length(segments) + 1]] <- data.frame(
      g_start = exon_df$start[i], g_end = exon_df$end[i],
      d_start = cursor, d_end = cursor + ex_disp_len, type = "exon"
    )
    cursor <- cursor + ex_disp_len
    if (i < nrow(exon_df)) {
      segments[[length(segments) + 1]] <- data.frame(
        g_start = exon_df$end[i], g_end = exon_df$start[i + 1],
        d_start = cursor, d_end = cursor + intron_display_width, type = "intron"
      )
      cursor <- cursor + intron_display_width
    }
  }
  axis_map <- bind_rows(segments)
  #print(axis_map)
  Vectorize(function(g_pos) {
    seg <- axis_map[g_pos >= pmin(axis_map$g_start, axis_map$g_end) &
                      g_pos <= pmax(axis_map$g_start, axis_map$g_end), ][1, ]
    if (nrow(seg) == 0) return(NA_real_)
    frac <- (g_pos - seg$g_start) / (seg$g_end - seg$g_start)
    seg$d_start + frac * (seg$d_end - seg$d_start)
  })
}

#' Transcripts genuinely involved in this event: for SE, transcripts
#' whose exon ends exactly at c1 AND whose exon starts exactly at c4
#' -- i.e. the flanking exons that define the alternative region.
#' (For RI you'd instead check exon boundaries at c2/c3 -- the intron
#' itself -- if you need an RI-specific transcript filter.)
get_transcripts_for_se_event <- function(gtf, gene_id_val, c1, c4,total_transcripts) {
  
  # split the comma-separated transcript list from the .ioe file into a vector
  event_transcripts <- str_split(total_transcripts, ",")[[1]] %>% trimws()
  
  all_ex <- gtf[gtf$type == "exon" & gtf$gene_id == gene_id_val & gtf$transcript_id %in% event_transcripts] %>%
    as.data.frame() %>%
    dplyr::select(transcript_id, seqnames, start, end, strand) %>%
    dplyr::distinct() %>%
    dplyr::arrange(transcript_id, start)
}

#' Tag which exon (in the transcript track) corresponds to which
#' role in an SE event, so it can be highlighted in a different color.
mark_affected_exons_se <- function(tx_exons, c1, c2, c3, c4) {
  tx_exons %>%
    mutate(affected = case_when(
      start == c2 & end == c3 ~ "skipped_exon",
      end   == c1              ~ "upstream_flank",
      start == c4              ~ "downstream_flank",
      TRUE                     ~ "other"
    ))
}

#RI
#' Transcripts genuinely spanning this RI event: retained-form
#' transcripts have ONE exon covering the full c2->c3 span (no
#' junction there); spliced-form transcripts have separate exons
#' ending at c2 and starting at c3. This pulls transcripts matching
#' EITHER pattern so both isoforms show up in the track.
get_transcripts_for_ri_event <- function(gtf, gene_id_val, c2, c3,total_transcripts) {
  
  # split the comma-separated transcript list from the .ioe file into a vector
  event_transcripts <- str_split(total_transcripts, ",")[[1]] %>% trimws()
  
  all_ex <- gtf[gtf$type == "exon" & gtf$gene_id == gene_id_val & gtf$transcript_id %in% event_transcripts] %>%
    as.data.frame() %>%
    dplyr::select(transcript_id, seqnames, start, end, strand) %>%
    dplyr::distinct() %>%
    dplyr::arrange(transcript_id, start)
}


#' Tag exon roles for an RI event: the exon that spans straight
#' through the intron (retained form) vs the flanking exons that
#' stop/start right at the intron boundary (spliced form).
mark_affected_exons_ri <- function(tx_exons, c2, c3) {
  tx_exons %>%
    mutate(affected = case_when(
      start <= c2 & end >= c3 ~ "retained_intron_exon",
      end   == c2              ~ "upstream_flank",
      start == c3              ~ "downstream_flank",
      TRUE                     ~ "other"
    ))
}

