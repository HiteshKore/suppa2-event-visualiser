plot_panel <- function(cond_label) {
  arc_c <- arcs %>% filter(condition == cond_label)
  label_pts <- arc_c %>% group_by(junc_id, arc_type) %>% dplyr::slice(which.max(y))
  ggplot() +
    geom_segment(aes(x = c1 - pad, xend = c4 + pad, y = 0, yend = 0),
                 color = "black", linewidth = 0.4) +
    geom_rect(data = exons, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
              fill = "black") +
    geom_path(data = arc_c,
              aes(x = x, y = y, group = junc_id, linewidth = weight, alpha = weight),
              color = "firebrick") +
    geom_text(data = label_pts,
              aes(x = x, y = y + 0.1, label = sprintf("%.2f", weight)),
              size = 3.2, color = "firebrick") +
    scale_linewidth(range = c(0.4, 4), limits = c(0, 1), guide = "none") +
    scale_alpha(range = c(0.45, 1), limits = c(0, 1), guide = "none") +
    coord_cartesian(xlim = xlim_shared, ylim = c(-0.1, 1.6)) +
    labs(y = cond_label) +
    theme_void() +
    theme(axis.title.y = element_text(angle = 90, size = 11, face = "bold"),
          plot.margin = margin(8, 12, 8, 12))
}